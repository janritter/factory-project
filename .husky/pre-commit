# Staged files only (added/copied/modified/renamed)
FILES=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$FILES" ] && exit 0

echo "$FILES" | tr '\n' '\0' | xargs -0 npx prettier --check --ignore-unknown || {
  echo "\nPrettier check failed. Run: npx prettier --write <files>, re-stage, and commit again."
  exit 1
}

echo "$FILES" | tr '\n' '\0' | xargs -0 npx tsx scripts/check-file-size.ts
