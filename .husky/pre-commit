# Staged files only (added/copied/modified/renamed)
FILES=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$FILES" ] && exit 0

echo "$FILES" | tr '\n' '\0' | xargs -0 node_modules/.bin/oxfmt --check --no-error-on-unmatched-pattern || {
  echo "\nFormat check failed. Run: npm run format, re-stage, and commit again."
  exit 1
}

echo "$FILES" | tr '\n' '\0' | xargs -0 node scripts/check-file-size.ts
